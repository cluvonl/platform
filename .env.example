# Kopieer naar .env.local. Geen secrets in Git.
APP_ENV=local
APP_MODE=prototype
APP_URL=http://localhost:3000
RELEASE_SHA=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secrets alleen server/worker. Niet nodig om de UI te bekijken.
SUPABASE_SECRET_KEY=
MIGRATION_DATABASE_URL=
BACKUP_DATABASE_URL=
MAIL_DRIVER=log
MAIL_ALLOWLIST=
SPORTLINK_DRIVER=fixture
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Production wordt ook in instrumentation.ts en de releasegate geweigerd.
