#!/usr/bin/env bash
# Installeer als root-beheerd vast script. Geen vrij te kiezen shellcommando's.
set -euo pipefail
umask 077
[[ $# == 3 ]] || { echo 'Usage: cluvo-deploy-staging IMAGE@DIGEST SOURCE_SHA RUN_ID' >&2; exit 64; }
image="$1"; sha="$2"; run_id="$3"
[[ "$image" =~ ^ghcr\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]] || exit 64
[[ "$sha" =~ ^[0-9a-f]{40}$ && "$run_id" =~ ^[0-9]+$ ]] || exit 64
readonly config=/etc/cluvo/staging-target.json
readonly compose=/etc/cluvo/compose.staging.yml
readonly runtime=/etc/cluvo/staging.env
readonly state=/var/lib/cluvo-staging
[[ -f "$config" && -f "$compose" && -f "$runtime" && -d "$state" ]] || { echo 'Stagingbootstrap ontbreekt' >&2; exit 78; }
exec 9>"$state/deploy.lock"
flock -w 600 9
# Controleer doelconfig zonder secrets te printen of .env als shellcode te sourcen.
python3 - "$config" "$runtime" "$image" "$run_id" "$state/current.json" <<'PREFLIGHT'
import json,sys,pathlib
config,envfile,image,run,current=sys.argv[1:]
c=json.load(open(config));e={}
for line in open(envfile):
 line=line.strip()
 if line and not line.startswith('#'):
  k,_,v=line.partition('=');e[k]=v.strip().strip('"').strip("'")
assert 'REPLACE' not in c['image_repository'], 'Vul staging-target.json in'
assert image.split('@')[0]==c['image_repository'], 'Onverwacht imageregister'
assert e.get('APP_ENV')=='staging' and e.get('APP_MODE')=='prototype', 'Deze broker is uitsluitend voor het stagingprototype'
assert e.get('APP_URL')==c['app_url'] and c['app_url'].startswith('https://') and 'REPLACE' not in c['app_url'], 'Onverwachte apporigin'
assert e.get('SUPABASE_URL','')==c.get('supabase_url',''), 'Onverwacht Supabaseproject'
if pathlib.Path(current).exists():
 old=json.load(open(current));assert int(run)>=int(old['workflow_run_id']), 'Oudere run mag nieuwere staging niet overschrijven'
PREFLIGHT
export CLUVO_IMAGE="$image" CLUVO_RELEASE_SHA="$sha"
docker pull "$image"
revision="$(docker image inspect "$image" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')"
[[ "$revision" == "$sha" ]] || { echo 'Image en broncommit verschillen' >&2; exit 65; }
previous_image=''; previous_sha=''
if [[ -f "$state/current.json" ]]; then
 previous_image="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["image"])' "$state/current.json")"
 previous_sha="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["source_sha"])' "$state/current.json")"
fi
recover() {
 echo 'Nieuwe release faalde; vorige apprelease herstellen indien beschikbaar' >&2
 if [[ -n "$previous_image" ]]; then
  CLUVO_IMAGE="$previous_image" CLUVO_RELEASE_SHA="$previous_sha" docker compose -p cluvo-staging -f "$compose" up -d --no-build --wait --wait-timeout 120 web || echo 'Herstel is ook mislukt: operatoractie nodig' >&2
 else
  docker compose -p cluvo-staging -f "$compose" stop web || true
 fi
 exit 1
}
# Prototypebootstrap: GEEN datamigraties; korte herstartonderbreking mogelijk.
trap recover ERR
docker compose -p cluvo-staging -f "$compose" up -d --no-build --wait --wait-timeout 120 web
python3 - "$sha" <<'HEALTH'
import json,urllib.request,sys
r=json.load(urllib.request.urlopen('http://127.0.0.1:3100/api/health/live',timeout=10))
assert r['status']=='ok' and r['environment']=='staging' and r['mode']=='prototype' and r['release']==sys.argv[1]
HEALTH
python3 - "$state" "$image" "$sha" "$run_id" <<'RECORD'
import json,sys,datetime,pathlib,os
state,image,sha,run=sys.argv[1:];p=pathlib.Path(state)
data={'image':image,'source_sha':sha,'workflow_run_id':run,'staging_verified_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'mode':'prototype','database_migrated':False,'v1_ready':False}
if (p/'current.json').exists():(p/'previous.json').write_text((p/'current.json').read_text())
(p/'candidate.json').write_text(json.dumps(data,indent=2));os.replace(p/'candidate.json',p/'current.json')
with (p/'deployments.jsonl').open('a') as f:f.write(json.dumps(data)+'\n')
RECORD
trap - ERR
echo 'Stagingprototype gepubliceerd en release gecontroleerd. Production blijft geblokkeerd.'
