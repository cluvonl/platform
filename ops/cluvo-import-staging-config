#!/usr/bin/python3 -I
"""Fixed staging-only runtime import. Credentials arrive only through stdin."""

import fcntl
import grp
import hashlib
import json
import os
import pathlib
import re
import select
import signal
import stat
import sys
import time

CONFIG_DIR = pathlib.Path('/etc/cluvo')
STATE_DIR = pathlib.Path('/var/lib/cluvo-staging')
TRUSTED_ROOT = pathlib.Path('/')
ROOT_UID = 0
RUNTIME_GROUP = 'cluvo-staging'
PROJECT = 'fbozlbgmktkgcdfqdaaz'
ORIGIN = 'https://staging.cluvo.nl'
SUPABASE_URL = 'https://' + PROJECT + '.supabase.co'
REGISTRY = 'ghcr.io/cluvonl/platform'
FORMAT = 'cluvo-staging-runtime-config-v1'
MAX_INPUT = 32768
MAX_FILE = 262144
FIELDS = frozenset((
    'format', 'source_sha', 'workflow_run_id', 'expected_source_sha',
    'expected_config_version', 'actor', 'project_ref', 'app_url', 'supabase_url',
    'supabase_publishable_key', 'supabase_secret_key', 'invitation_token_secret',
    'mail_allowlist', 'compatible_rollback_shas',
))
MANAGED = frozenset((
    'APP_ENV', 'APP_MODE', 'APP_URL', 'SUPABASE_URL',
    'SUPABASE_PUBLISHABLE_KEY', 'SUPABASE_SECRET_KEY',
    'INVITATION_TOKEN_SECRET', 'MAIL_ALLOWLIST',
))
JOURNAL = 'config-import.pending'


class Refused(Exception):
    def __init__(self, code):
        self.code = code


def need(condition, code='CONFIG_IMPORT_REFUSED'):
    if not condition:
        raise Refused(code)


def sha(value):
    return isinstance(value, str) and re.fullmatch(r'[0-9a-f]{40}', value) is not None


def run_id(value):
    return isinstance(value, str) and re.fullmatch(r'[1-9][0-9]{0,19}', value) is not None


def duplicate_free(pairs):
    result = {}
    for key, value in pairs:
        need(key not in result)
        result[key] = value
    return result


def decode(data):
    try:
        return json.loads(data.decode('utf-8'), object_pairs_hook=duplicate_free,
                          parse_constant=lambda unused: (_ for _ in ()).throw(Refused('CONFIG_IMPORT_REFUSED')))
    except Refused:
        raise
    except Exception:
        raise Refused('CONFIG_IMPORT_REFUSED') from None


def encoded(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=True) + '\n').encode()


def protected_directory(path):
    """Walk from the immutable root using directory descriptors, without links."""
    path = pathlib.Path(path)
    relative = path.relative_to(TRUSTED_ROOT)
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    descriptor = os.open(TRUSTED_ROOT, flags)
    try:
        info = os.fstat(descriptor)
        need(info.st_uid == ROOT_UID and not info.st_mode & 0o022, 'CONFIG_FILES_UNSAFE')
        for part in relative.parts:
            successor = os.open(part, flags, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = successor
            info = os.fstat(descriptor)
            need(info.st_uid == ROOT_UID and not info.st_mode & 0o022, 'CONFIG_FILES_UNSAFE')
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def read_file(directory, name, private=False, optional=False, readable_group=None):
    try:
        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=directory)
    except FileNotFoundError:
        need(optional, 'CONFIG_FILES_UNAVAILABLE')
        return None
    try:
        info = os.fstat(descriptor)
        need(stat.S_ISREG(info.st_mode) and info.st_uid == ROOT_UID and info.st_nlink == 1
             and not info.st_mode & 0o022 and info.st_size <= MAX_FILE, 'CONFIG_FILES_UNSAFE')
        need(not private or not info.st_mode & 0o007, 'CONFIG_FILES_UNSAFE')
        need(not private or not info.st_mode & 0o070 or
             (readable_group is not None and info.st_gid == readable_group and info.st_mode & 0o070 == 0o040),
             'CONFIG_FILES_UNSAFE')
        chunks, total = [], 0
        while True:
            chunk = os.read(descriptor, 16384)
            if not chunk:
                break
            total += len(chunk)
            need(total <= MAX_FILE, 'CONFIG_FILES_UNSAFE')
            chunks.append(chunk)
        after = os.fstat(descriptor)
        need((info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns) ==
             (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns), 'CONFIG_FILES_UNSAFE')
        return {'bytes': b''.join(chunks), 'mode': stat.S_IMODE(info.st_mode), 'gid': info.st_gid}
    finally:
        os.close(descriptor)


def atomic_write(directory, name, data, mode, gid):
    temporary = '.cluvo-import-' + os.urandom(16).hex()
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                         0o600, dir_fd=directory)
    try:
        # An interrupted write leaves only a private, owned temporary file.
        # Final runtime group/mode apply after publication, with the lock held.
        os.fchown(descriptor, ROOT_UID, ROOT_UID)
        os.fchmod(descriptor, 0o600)
        position = 0
        while position < len(data):
            written = os.write(descriptor, data[position:])
            need(written > 0, 'CONFIG_IMPORT_UNAVAILABLE')
            position += written
        os.fsync(descriptor)
        os.replace(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
        os.fchown(descriptor, ROOT_UID, gid)
        os.fchmod(descriptor, mode)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.fsync(directory)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass


def read_stdin():
    deadline = time.monotonic() + 30
    chunks, total = [], 0
    while True:
        remaining = deadline - time.monotonic()
        need(remaining > 0, 'CONFIG_INPUT_TIMEOUT')
        ready, _, _ = select.select([sys.stdin.fileno()], [], [], remaining)
        need(ready, 'CONFIG_INPUT_TIMEOUT')
        chunk = os.read(sys.stdin.fileno(), min(16384, MAX_INPUT + 1 - total))
        if not chunk:
            return b''.join(chunks)
        chunks.append(chunk)
        total += len(chunk)
        need(total <= MAX_INPUT)


def validate_payload(payload, source, identifier):
    need(type(payload) is dict and set(payload) == FIELDS)
    need(payload['format'] == FORMAT and payload['source_sha'] == source and
         payload['workflow_run_id'] == identifier and sha(payload['expected_source_sha']))
    need(type(payload['expected_config_version']) is int and 0 <= payload['expected_config_version'] < 1000000)
    need(isinstance(payload['actor'], str) and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.\[\]-]{0,63}', payload['actor']))
    need(payload['project_ref'] == PROJECT and payload['app_url'] == ORIGIN and payload['supabase_url'] == SUPABASE_URL)
    for key, prefix in (('supabase_publishable_key', 'sb_publishable_'), ('supabase_secret_key', 'sb_secret_')):
        value = payload[key]
        need(isinstance(value, str) and len(value) <= 4096 and
             re.fullmatch(re.escape(prefix) + r'[A-Za-z0-9_-]+', value))
    secret = payload['invitation_token_secret']
    # Single quoted Compose values are literal. Quotes, backslashes and control
    # characters are refused rather than silently changing a secret's bytes.
    need(isinstance(secret, str) and 32 <= len(secret.encode('utf-8')) <= 4096 and
         all(0x20 <= ord(character) <= 0x7e and character not in "'\\" for character in secret))
    allowlist = payload['mail_allowlist']
    need(isinstance(allowlist, str) and 0 < len(allowlist) <= 16384 and not re.search(r'[\r\n\x00\x01-\x1f]', allowlist))
    recipients = [item for item in re.split(r'[ ,;]+', allowlist) if item]
    need(recipients and len(recipients) <= 32 and len(set(item.lower() for item in recipients)) == len(recipients))
    need(all(re.fullmatch(r'[A-Za-z0-9.!#$%&+/?^_`{|}~-]+@[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?\.[A-Za-z]{2,63}', item)
             and '*' not in item for item in recipients))
    compatible = payload['compatible_rollback_shas']
    need(type(compatible) is list and 1 <= len(compatible) <= 16 and all(sha(item) for item in compatible)
         and len(set(compatible)) == len(compatible) and payload['expected_source_sha'] in compatible)
    return ','.join(recipients)


def environment_bytes(original, payload, allowlist):
    try:
        lines = original.decode('utf-8').splitlines(keepends=True)
    except UnicodeError:
        raise Refused('CONFIG_FILES_UNSAFE') from None
    retained, existing = [], {}
    for raw_line in lines:
        line = raw_line.strip()
        if not line or line.startswith('#'):
            retained.append(raw_line)
            continue
        key, separator, value = line.partition('=')
        need(separator and re.fullmatch(r'[A-Z_][A-Z0-9_]*', key) and key not in existing, 'CONFIG_FILES_UNSAFE')
        existing[key] = value.strip().strip('"').strip("'")
        if key not in MANAGED:
            retained.append(raw_line)
    need(existing.get('APP_ENV') == 'staging' and existing.get('APP_MODE') in ('prototype', 'app'), 'CONFIG_TARGET_MISMATCH')
    need(existing.get('APP_URL') == ORIGIN and existing.get('SUPABASE_URL', '') in ('', SUPABASE_URL), 'CONFIG_TARGET_MISMATCH')
    need(not any(existing.get(key) for key in ('MIGRATION_DATABASE_URL', 'STAGING_BACKUP_ENCRYPTION_KEY')), 'CONFIG_FILES_UNSAFE')
    if retained and not retained[-1].endswith('\n'):
        retained[-1] += '\n'
    values = {
        'APP_ENV': 'staging', 'APP_MODE': 'app', 'APP_URL': ORIGIN,
        'SUPABASE_URL': SUPABASE_URL,
        'SUPABASE_PUBLISHABLE_KEY': payload['supabase_publishable_key'],
        'SUPABASE_SECRET_KEY': payload['supabase_secret_key'],
        'INVITATION_TOKEN_SECRET': payload['invitation_token_secret'], 'MAIL_ALLOWLIST': allowlist,
    }
    return (''.join(retained) + ''.join(key + "='" + value + "'\n" for key, value in values.items())).encode('utf-8')


def journal_open(state):
    try:
        descriptor = os.open(JOURNAL, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=state)
    except FileNotFoundError:
        return None
    info = os.fstat(descriptor)
    if info.st_uid != ROOT_UID or stat.S_IMODE(info.st_mode) != 0o700:
        os.close(descriptor)
        raise Refused('CONFIG_RECOVERY_REQUIRED')
    return descriptor


def remove_journal(state, directory):
    allowed = {'environment.old', 'target.old', 'state.old', 'metadata.json'}
    names = set(os.listdir(directory))
    temporaries = {name for name in names if re.fullmatch(r'\.cluvo-import-[0-9a-f]{32}', name)}
    need(names <= allowed | temporaries and len(temporaries) <= 64, 'CONFIG_RECOVERY_REQUIRED')
    # Validate every remaining file before deleting any. Cleanup may resume
    # after a crash with any subset of backups already removed.
    for name in names:
        value = read_file(directory, name, private=True)
        need(value['mode'] == 0o600 and value['gid'] == ROOT_UID, 'CONFIG_RECOVERY_REQUIRED')
    for name in sorted(names - {'metadata.json'}):
        os.unlink(name, dir_fd=directory)
    os.fsync(directory)
    # This marker is deleted last, after backup deletion is durable. Its phase
    # distinguishes incomplete application from incomplete cleanup.
    if 'metadata.json' in names:
        os.unlink('metadata.json', dir_fd=directory)
        os.fsync(directory)
    os.rmdir(JOURNAL, dir_fd=state)
    os.fsync(state)


def cleanup_temporaries(directory):
    names = sorted(name for name in os.listdir(directory) if re.fullmatch(r'\.cluvo-import-[0-9a-f]{32}', name))
    need(len(names) <= 64, 'CONFIG_RECOVERY_REQUIRED')
    for name in names:
        value = read_file(directory, name, private=True)
        need(value['mode'] == 0o600 and value['gid'] == ROOT_UID, 'CONFIG_RECOVERY_REQUIRED')
    for name in names:
        os.unlink(name, dir_fd=directory)
    if names:
        os.fsync(directory)


def recover(config, state):
    directory = journal_open(state)
    if directory is None:
        return
    try:
        metadata_file = read_file(directory, 'metadata.json', private=True, optional=True)
        if metadata_file is None:
            # No active-file mutation occurs until all backups and metadata are
            # durable. A crash during preparation can therefore be cleaned up.
            remove_journal(state, directory)
            os.close(directory)
            directory = None
            return
        metadata = decode(metadata_file['bytes'])
        need(type(metadata) is dict and set(metadata) == {'files', 'phase'} and
             metadata['phase'] in ('prepared', 'committed', 'rolled_back'), 'CONFIG_RECOVERY_REQUIRED')
        need(type(metadata['files']) is list and len(metadata['files']) == 3, 'CONFIG_RECOVERY_REQUIRED')
        destinations = [('environment.old', config, 'staging.env'), ('target.old', config, 'staging-target.json'),
                        ('state.old', state, 'config-import.json')]
        backups = []
        for entry, (backup, destination, name) in zip(metadata['files'], destinations):
            need(type(entry) is dict and set(entry) == {'present', 'mode', 'gid', 'sha256'} and type(entry['present']) is bool,
                 'CONFIG_RECOVERY_REQUIRED')
            if entry['present']:
                need(type(entry['mode']) is int and 0 <= entry['mode'] <= 0o777 and not entry['mode'] & 0o022 and
                     type(entry['gid']) is int and entry['gid'] >= 0 and
                     isinstance(entry['sha256'], str) and re.fullmatch(r'[0-9a-f]{64}', entry['sha256']), 'CONFIG_RECOVERY_REQUIRED')
                if metadata['phase'] == 'prepared':
                    value = read_file(directory, backup, private=True)
                    need(hashlib.sha256(value['bytes']).hexdigest() == entry['sha256'], 'CONFIG_RECOVERY_REQUIRED')
                    backups.append((destination, name, value['bytes'], entry['mode'], entry['gid']))
            else:
                need(backup == 'state.old' and entry['mode'] is None and entry['gid'] is None and entry['sha256'] is None,
                     'CONFIG_RECOVERY_REQUIRED')
                backups.append((destination, name, None, None, None))
        if metadata['phase'] == 'prepared':
            for destination, name, data, mode, gid in backups:
                if data is None:
                    try:
                        os.unlink(name, dir_fd=destination)
                    except FileNotFoundError:
                        pass
                    os.fsync(destination)
                else:
                    atomic_write(destination, name, data, mode, gid)
            # Restoration is durable before any old bytes are deleted. A crash
            # during subsequent cleanup must not require deleted backup files.
            metadata['phase'] = 'rolled_back'
            atomic_write(directory, 'metadata.json', encoded(metadata), 0o600, ROOT_UID)
        remove_journal(state, directory)
        os.close(directory)
        directory = None
    finally:
        if directory is not None:
            os.close(directory)


def transaction(config, state, old_files, new_files):
    os.mkdir(JOURNAL, 0o700, dir_fd=state)
    os.fsync(state)
    directory = journal_open(state)
    metadata = {'phase': 'prepared', 'files': []}
    try:
        for backup, value in zip(('environment.old', 'target.old', 'state.old'), old_files):
            present = value is not None
            metadata['files'].append({'present': present, 'mode': value['mode'] if present else None,
                                      'gid': value['gid'] if present else None,
                                      'sha256': hashlib.sha256(value['bytes']).hexdigest() if present else None})
            if present:
                atomic_write(directory, backup, value['bytes'], 0o600, ROOT_UID)
        atomic_write(directory, 'metadata.json', encoded(metadata), 0o600, ROOT_UID)
        for destination, name, data, mode, gid in new_files:
            atomic_write(destination, name, data, mode, gid)
        metadata['phase'] = 'committed'
        atomic_write(directory, 'metadata.json', encoded(metadata), 0o600, ROOT_UID)
    except BaseException:
        os.close(directory)
        try:
            recover(config, state)
        except BaseException:
            raise Refused('CONFIG_RECOVERY_REQUIRED') from None
        raise
    else:
        try:
            remove_journal(state, directory)
        finally:
            os.close(directory)


def configure(payload, source, identifier):
    allowlist = validate_payload(payload, source, identifier)
    config, state, lock = None, None, None
    try:
        config = protected_directory(CONFIG_DIR)
        state = protected_directory(STATE_DIR)
        lock = os.open('deploy.lock', os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=state)
        info = os.fstat(lock)
        need(stat.S_ISREG(info.st_mode) and info.st_uid == ROOT_UID and info.st_nlink == 1 and
             not info.st_mode & 0o077, 'CONFIG_FILES_UNSAFE')
        deadline = time.monotonic() + 60
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                need(time.monotonic() < deadline, 'CONFIG_LOCK_BUSY')
                time.sleep(0.1)
        recover(config, state)
        cleanup_temporaries(config)
        cleanup_temporaries(state)
        runtime_group = grp.getgrnam(RUNTIME_GROUP).gr_gid
        runtime = read_file(config, 'staging.env', private=True, readable_group=runtime_group)
        target_file = read_file(config, 'staging-target.json')
        current_file = read_file(state, 'current.json', private=True)
        import_file = read_file(state, 'config-import.json', private=True, optional=True)
        target, current = decode(target_file['bytes']), decode(current_file['bytes'])
        need(type(target) is dict and target.get('image_repository') == REGISTRY and target.get('app_url') == ORIGIN and
             target.get('app_mode', 'prototype') in ('prototype', 'app') and target.get('supabase_url', '') in ('', SUPABASE_URL) and
             target.get('supabase_project_ref', '') in ('', PROJECT) and target.get('production_enabled', False) is False,
             'CONFIG_TARGET_MISMATCH')
        need(type(current) is dict and sha(current.get('source_sha')) and run_id(current.get('workflow_run_id')) and
             current.get('mode', 'prototype') in ('prototype', 'app'), 'CONFIG_FILES_UNSAFE')
        previous = decode(import_file['bytes']) if import_file else {'version': 0, 'audit': []}
        need(type(previous) is dict and type(previous.get('version')) is int and
             0 <= previous['version'] < 1000000 and type(previous.get('audit')) is list, 'CONFIG_FILES_UNSAFE')
        payload_hash = hashlib.sha256(encoded(payload)).hexdigest()
        if previous.get('workflow_run_id') == identifier:
            need(previous.get('source_sha') == source and previous.get('payload_sha256') == payload_hash,
                 'CONFIG_IMPORT_REPLAY_REFUSED')
            desired = environment_bytes(runtime['bytes'], payload, allowlist)
            need(desired == runtime['bytes'] and target.get('app_mode') == 'app' and
                 target.get('supabase_project_ref') == PROJECT and target.get('supabase_url') == SUPABASE_URL and
                 target.get('compatible_rollback_shas') == payload['compatible_rollback_shas'] and
                 target.get('config_import_version') == previous['version'], 'CONFIG_IMPORT_REPLAY_REFUSED')
            return 'already_configured', previous['version']
        need(current['source_sha'] == payload['expected_source_sha'], 'CONFIG_EXPECTATION_CHANGED')
        need(int(identifier) > int(current['workflow_run_id']) and
             (not previous.get('workflow_run_id') or int(identifier) > int(previous['workflow_run_id'])), 'CONFIG_IMPORT_REPLAY_REFUSED')
        need(previous['version'] == payload['expected_config_version'], 'CONFIG_EXPECTATION_CHANGED')
        new_runtime = environment_bytes(runtime['bytes'], payload, allowlist)
        version = previous['version'] + 1
        target.update(app_mode='app', supabase_project_ref=PROJECT, supabase_url=SUPABASE_URL,
                      compatible_rollback_shas=payload['compatible_rollback_shas'], production_enabled=False,
                      config_import_version=version)
        audit = previous['audit'] + [{'actor': payload['actor'], 'scope': 'staging', 'expected_version': previous['version'],
                                     'version': version, 'source_sha': source, 'workflow_run_id': identifier,
                                     'idempotency_key': 'github-staging-config:' + identifier,
                                     'previous_source_sha': current['source_sha'], 'recorded_at': int(time.time())}]
        record = {'version': version, 'source_sha': source, 'workflow_run_id': identifier,
                  'payload_sha256': payload_hash, 'audit': audit}
        new_target, new_record = encoded(target), encoded(record)
        need(max(len(new_runtime), len(new_target), len(new_record)) <= MAX_FILE, 'CONFIG_FILES_UNSAFE')
        transaction(config, state, (runtime, target_file, import_file),
                    ((config, 'staging.env', new_runtime, 0o640, runtime_group),
                     (config, 'staging-target.json', new_target, target_file['mode'], target_file['gid']),
                     (state, 'config-import.json', new_record, 0o600, ROOT_UID)))
        return 'configured', version
    finally:
        for descriptor in (lock, state, config):
            if descriptor is not None:
                os.close(descriptor)


def main(arguments):
    try:
        need(os.geteuid() == ROOT_UID, 'CONFIG_ROOT_REQUIRED')
        need(len(arguments) == 2 and sha(arguments[0]) and run_id(arguments[1]))
        def interrupted(unused_signal, unused_frame):
            raise Refused('CONFIG_IMPORT_INTERRUPTED')
        signal.signal(signal.SIGTERM, interrupted)
        signal.signal(signal.SIGINT, interrupted)
        payload = decode(read_stdin())
        status, version = configure(payload, arguments[0], arguments[1])
        print(json.dumps({'status': status, 'config_version': version, 'source_sha': arguments[0],
                          'workflow_run_id': arguments[1], 'production_enabled': False,
                          'database_mutations': False, 'mail_delivery_claim': False}, sort_keys=True))
        return 0
    except Refused as error:
        print(json.dumps({'status': 'refused', 'code': error.code}, sort_keys=True))
        return 1
    except BaseException:
        print(json.dumps({'status': 'refused', 'code': 'CONFIG_IMPORT_UNAVAILABLE'}, sort_keys=True))
        return 1


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
