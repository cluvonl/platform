-- Explicit additive local browser fixture: a second past execution for F075.
-- Only new synthetic cb resources; never replace Auth, existing bookings or ledger.
\if :{?cluvo_native_pwa_fixture}
\else
\echo 'Refused: requires -v cluvo_native_pwa_fixture=1'
\quit
\endif
\set ON_ERROR_STOP on
begin;
do $fixture$ declare
 t uuid:='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
 a uuid:='11111111-1111-4111-8111-111111111111';
 coordinator uuid:='33333333-3333-4333-8333-333333333333';
 source_shift app.shifts%rowtype;
 source_booking app.bookings%rowtype;
 target_shift uuid:='cb000000-0000-4000-8000-000000000805';
 target_position uuid:='cb000000-0000-4000-8000-000000000835';
 target_booking uuid:='cb000000-0000-4000-8000-000000000905';
 target_instruction uuid:='cb000000-0000-4000-8000-000000000825';
 instruction_body text:='Controleer deze tweede lokale uitvoering afzonderlijk. Een niet-uitgevoerde taak levert geen minuten op.';
begin
 if current_database()<>'postgres' or current_user<>'postgres' or current_setting('cluvo.local_fixture',true) is distinct from 'native-pwa-batch-fixture' then raise exception 'LOCAL_BATCH_FIXTURE_GUARD_REQUIRED';end if;
 if not exists(select 1 from app.tenants where id=t and slug='club-a') then raise exception 'LOCAL_BATCH_FIXTURE_TENANT_MISMATCH';end if;
 select * into strict source_shift from app.shifts where tenant_id=t and id='cb000000-0000-4000-8000-000000000804';
 select * into strict source_booking from app.bookings where tenant_id=t and id='cb000000-0000-4000-8000-000000000904';
 if source_shift.committee_id<>'cb000000-0000-4000-8000-000000000300'::uuid or source_shift.title<>'PWA uitvoering controleren' or source_shift.type_version_id<>'cb000000-0000-4000-8000-000000000721'::uuid or source_shift.ends_at>=statement_timestamp() or source_booking.position_id<>'cb000000-0000-4000-8000-000000000834'::uuid or source_booking.obligation_id<>'cb000000-0000-4000-8000-000000000600'::uuid or source_booking.booked_by_auth_user_id<>a then raise exception 'OWNED_SYNTHETIC_BATCH_SOURCE_REQUIRED';end if;
 if not exists(select 1 from app.account_person_links l join auth.users u on u.id=l.auth_user_id where l.tenant_id=t and l.auth_user_id=a and l.person_id=source_booking.executor_person_id and l.verified_at is not null and l.revoked_at is null and u.email like '%@example.test' and u.email_confirmed_at is not null) then raise exception 'SYNTHETIC_EXISTING_ACTOR_REQUIRED';end if;
 if exists(select 1 from app.shifts where id=target_shift) then
  if not exists(select 1 from app.shifts where id=target_shift and tenant_id=t and title='PWA tweede uitvoering controleren' and committee_id=source_shift.committee_id)
   or not exists(select 1 from app.bookings where id=target_booking and tenant_id=t and position_id=target_position and executor_person_id=source_booking.executor_person_id and obligation_id=source_booking.obligation_id)
   or not exists(select 1 from app.pwa_booking_details where tenant_id=t and booking_id=target_booking and instruction_version_id=target_instruction) then raise exception 'EXISTING_BATCH_FIXTURE_MISMATCH';end if;
  return; -- Preserve any already performed UI confirmations and immutable ledger.
 end if;
 insert into app.shifts(id,tenant_id,type_version_id,committee_id,category_id,title,starts_at,ends_at,credit_minutes,cancellation_minutes,state,published_at)
 values(target_shift,t,source_shift.type_version_id,source_shift.committee_id,source_shift.category_id,'PWA tweede uitvoering controleren',source_shift.starts_at-interval '1 day',source_shift.ends_at-interval '1 day',source_shift.credit_minutes,source_shift.cancellation_minutes,'published',statement_timestamp());
 insert into app.shift_requirements(tenant_id,shift_id,minimum_age) values(t,target_shift,16);
 insert into app.shift_positions(id,tenant_id,shift_id,ordinal,starts_at,ends_at) values(target_position,t,target_shift,1,source_shift.starts_at-interval '1 day',source_shift.ends_at-interval '1 day');
 insert into app.pwa_instruction_versions(id,tenant_id,shift_id,revision,body,author_auth_user_id) values(target_instruction,t,target_shift,1,instruction_body,coordinator);
 insert into app.bookings(id,tenant_id,position_id,executor_person_id,obligation_id,booked_by_auth_user_id,starts_at_snapshot,ends_at_snapshot,credit_minutes_snapshot,cancellation_deadline_snapshot,task_version_snapshot,idempotency_key)
 values(target_booking,t,target_position,source_booking.executor_person_id,source_booking.obligation_id,a,source_shift.starts_at-interval '1 day',source_shift.ends_at-interval '1 day',source_booking.credit_minutes_snapshot,source_shift.starts_at-interval '3 days',source_booking.task_version_snapshot,'cb000000-0000-4000-8000-000000000925');
 insert into app.pwa_booking_details(tenant_id,booking_id,instruction_version_id,instruction_body_snapshot,title_snapshot,actor_auth_user_id) values(t,target_booking,target_instruction,instruction_body,'PWA tweede uitvoering controleren',a);
end;$fixture$;
commit;
select 'LOCAL_NATIVE_PWA_BATCH_FIXTURE' scope,'cb000000-0000-4000-8000-000000000905' second_pending_execution_id;
