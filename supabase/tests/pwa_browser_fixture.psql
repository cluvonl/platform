commit;
-- Only public synthetic resource identities are returned, never Auth metadata.
select 'LOCAL_NATIVE_PWA_FIXTURE' scope,'cb000000-0000-4000-8000-000000000100' household_id,'cb000000-0000-4000-8000-000000000400' team_id,'cb000000-0000-4000-8000-000000000801' free_task_id,'cb000000-0000-4000-8000-000000000904' pending_execution_id;
